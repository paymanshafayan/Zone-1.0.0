# Zone — Environment Configuration

# ─── General ───
NODE_ENV=development

# ─── API Server ───
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
WS_URL=ws://localhost:3001/ws

# ─── WebSocket Server ───
WS_PORT=3001

# ─── Database (PostgreSQL + PostGIS + pgvector) ───
DATABASE_URL=postgresql://zone:zone_dev_password@localhost:5432/zone

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Assistant (Cloud) ───
# Set your cloud provider API key here
# ASSISTANT_API_KEY=
# ASSISTANT_API_URL=

# ─── STT/TTS (Domestic) ───
# STT_API_URL=
# STT_API_KEY=
# TTS_API_URL=
# TTS_API_KEY=

# ─── Maps ───
# NESHAN_API_KEY=
